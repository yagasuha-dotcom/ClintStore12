<%- include('layouts/main') %>

<!-- Page Header -->
<section class="bg-secondary py-8">
  <div class="max-w-7xl mx-auto px-4">
    <h1 class="text-3xl font-bold">Keranjang Belanja</h1>
    <p class="text-gray-400 mt-2">Periksa dan kelola item di keranjang Anda</p>
  </div>
</section>

<!-- Cart Content -->
<section class="py-12 bg-primary">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid md:grid-cols-3 gap-8">
      <!-- Cart Items -->
      <div class="md:col-span-2">
        <div id="cart-items-container">
          <!-- Items will be loaded here by JavaScript -->
        </div>
      </div>

      <!-- Cart Summary -->
      <div>
        <div class="card-dark rounded-lg p-6 border border-gray-700 sticky top-24">
          <h3 class="text-lg font-bold text-accent mb-6">Ringkasan Pesanan</h3>

          <div class="space-y-4 mb-6 pb-6 border-b border-gray-700">
            <div class="flex justify-between text-gray-300">
              <span>Subtotal:</span>
              <span id="subtotal">Rp 0</span>
            </div>
            <div class="flex justify-between text-gray-300">
              <span>Diskon:</span>
              <span id="discount" class="text-green-400">Rp 0</span>
            </div>
            <div class="flex justify-between text-gray-300">
              <span>Pajak:</span>
              <span id="tax">Rp 0</span>
            </div>
          </div>

          <div class="flex justify-between items-center mb-6 text-xl font-bold">
            <span>Total:</span>
            <span id="total" class="text-accent">Rp 0</span>
          </div>

          <a href="/checkout" class="block w-full btn-primary text-white py-3 rounded-lg font-semibold text-center hover:shadow-lg transition mb-3">
            <i class="fas fa-arrow-right mr-2"></i>Lanjutkan Checkout
          </a>

          <a href="/produk" class="block w-full text-center border border-accent text-accent py-2 rounded-lg font-semibold hover:bg-accent/10 transition">
            Lanjut Belanja
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Empty Cart State -->
<template id="empty-cart-template">
  <div class="card-dark rounded-lg p-12 border border-gray-700 text-center">
    <i class="fas fa-shopping-cart text-5xl text-accent/50 mb-4"></i>
    <h3 class="text-xl font-bold mb-2">Keranjang Belanja Kosong</h3>
    <p class="text-gray-400 mb-6">
      Belum ada produk di keranjang Anda. Mari mulai belanja sekarang!
    </p>
    <a href="/produk" class="inline-block btn-primary text-white px-6 py-2 rounded-lg font-semibold hover:shadow-lg transition">
      <i class="fas fa-shopping-bag mr-2"></i>Mulai Belanja
    </a>
  </div>
</template>

<!-- Cart Item Template -->
<template id="cart-item-template">
  <div class="cart-item card-dark rounded-lg p-6 border border-gray-700 mb-4">
    <div class="flex flex-col md:flex-row gap-4">
      <!-- Item Image -->
      <div class="md:w-24 h-24 bg-gradient-to-br from-secondary to-primary rounded flex items-center justify-center flex-shrink-0">
        <i class="fas fa-box text-2xl text-accent/50"></i>
      </div>

      <!-- Item Details -->
      <div class="flex-1">
        <h4 class="font-bold text-lg mb-2 item-name">Product Name</h4>
        
        <!-- Data Target if exists -->
        <div class="text-sm text-gray-400 mb-2">
          <span class="item-data-target hidden">Target: <span class="font-semibold"></span></span>
        </div>

        <!-- Notes if exists -->
        <div class="text-sm text-gray-400 mb-2">
          <span class="item-notes hidden">Catatan: <span class="font-semibold text-gray-300"></span></span>
        </div>

        <!-- Quantity Controls -->
        <div class="flex items-center gap-2 mb-4">
          <button class="btn-qty-minus w-8 h-8 rounded text-sm bg-secondary hover:bg-accent transition">−</button>
          <input type="number" class="item-quantity w-12 text-center bg-secondary border border-gray-700 rounded px-2 py-1" min="1" value="1">
          <button class="btn-qty-plus w-8 h-8 rounded text-sm bg-secondary hover:bg-accent transition">+</button>
        </div>
      </div>

      <!-- Price & Remove -->
      <div class="md:w-32 text-right">
        <p class="text-accent font-bold text-lg mb-4 item-price">Rp 0</p>
        <button class="btn-remove w-full text-red-400 py-2 rounded hover:bg-red-500/20 transition text-sm font-semibold">
          <i class="fas fa-trash mr-1"></i>Hapus
        </button>
      </div>
    </div>
  </div>
</template>

<script>
  const CART_KEY = 'cart';

  function renderCart() {
    const cart = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
    const container = document.getElementById('cart-items-container');

    if (cart.length === 0) {
      const template = document.getElementById('empty-cart-template');
      container.innerHTML = template.innerHTML;
      updateSummary([]);
      return;
    }

    container.innerHTML = '';

    cart.forEach((item, index) => {
      const template = document.getElementById('cart-item-template');
      const clone = template.content.cloneNode(true);

      // Set item data
      clone.querySelector('.item-name').textContent = item.name;
      clone.querySelector('.item-price').textContent = `Rp ${(item.price * item.quantity).toLocaleString('id-ID')}`;
      clone.querySelector('.item-quantity').value = item.quantity;

      // Data target
      if (item.dataTarget) {
        const dataTargetEl = clone.querySelector('.item-data-target');
        dataTargetEl.querySelector('span').textContent = item.dataTarget;
        dataTargetEl.classList.remove('hidden');
      }

      // Notes
      if (item.notes) {
        const notesEl = clone.querySelector('.item-notes');
        notesEl.querySelector('span').textContent = item.notes;
        notesEl.classList.remove('hidden');
      }

      // Quantity handlers
      const qtyInput = clone.querySelector('.item-quantity');
      clone.querySelector('.btn-qty-minus').addEventListener('click', () => {
        const current = parseInt(qtyInput.value);
        if (current > 1) {
          qtyInput.value = current - 1;
          updateItemQuantity(index, current - 1);
        }
      });

      clone.querySelector('.btn-qty-plus').addEventListener('click', () => {
        qtyInput.value = parseInt(qtyInput.value) + 1;
        updateItemQuantity(index, parseInt(qtyInput.value));
      });

      // Remove handler
      clone.querySelector('.btn-remove').addEventListener('click', () => {
        removeItem(index);
      });

      container.appendChild(clone);
    });

    updateSummary(cart);
  }

  function updateItemQuantity(index, quantity) {
    const cart = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
    cart[index].quantity = quantity;
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
    renderCart();
  }

  function removeItem(index) {
    const cart = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
    cart.splice(index, 1);
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
    renderCart();
    window.dispatchEvent(new Event('storage'));
  }

  function updateSummary(cart) {
    let subtotal = 0;
    cart.forEach(item => {
      subtotal += item.price * item.quantity;
    });

    const tax = Math.round(subtotal * 0.1); // 10% tax
    const total = subtotal + tax;

    document.getElementById('subtotal').textContent = `Rp ${subtotal.toLocaleString('id-ID')}`;
    document.getElementById('tax').textContent = `Rp ${tax.toLocaleString('id-ID')}`;
    document.getElementById('total').textContent = `Rp ${total.toLocaleString('id-ID')}`;
  }

  // Initial render
  renderCart();

  // Listen for storage changes
  window.addEventListener('storage', renderCart);
</script>
