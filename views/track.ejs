<%- include('layouts/main') %>

<!-- Page Header -->
<section class="bg-secondary py-8">
  <div class="max-w-7xl mx-auto px-4">
    <h1 class="text-3xl font-bold">Cek Pesanan</h1>
    <p class="text-gray-400 mt-2">Masukkan nomor invoice untuk melihat status pesanan Anda</p>
  </div>
</section>

<!-- Main Content -->
<section class="py-12 bg-primary">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid md:grid-cols-3 gap-8">
      <!-- Search Form -->
      <div class="md:col-span-1">
        <div class="card-dark rounded-lg p-6 border border-gray-700 sticky top-24">
          <h3 class="text-lg font-bold text-accent mb-6">
            <i class="fas fa-search mr-2"></i>Cari Pesanan
          </h3>

          <form id="track-form" class="space-y-4">
            <div>
              <label class="block text-sm font-semibold mb-2">Nomor Invoice *</label>
              <input 
                type="text" 
                id="invoice_number"
                name="invoice_number"
                placeholder="Contoh: INV-1704110400000-ABC123XYZ" 
                required
                class="w-full bg-secondary border border-gray-700 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-accent transition"
              >
              <p class="text-xs text-gray-400 mt-1">Nomor invoice dikirim ke email Anda</p>
            </div>

            <button 
              type="submit"
              id="search-btn"
              class="w-full btn-primary text-white py-3 rounded-lg font-semibold hover:shadow-lg transition flex items-center justify-center"
            >
              <i class="fas fa-search mr-2"></i>Cari Pesanan
            </button>

            <div id="search-loading" class="hidden w-full bg-gray-600 text-white py-3 rounded-lg font-semibold text-center">
              <i class="fas fa-spinner fa-spin mr-2"></i>Mencari...
            </div>
          </form>

          <!-- Info Box -->
          <div class="mt-6 p-4 bg-blue-500/10 border border-blue-500/30 rounded text-blue-300 text-xs">
            <i class="fas fa-info-circle mr-2"></i>
            <span>Periksa email Anda untuk nomor invoice. Jika tidak menemukan, cek folder spam.</span>
          </div>
        </div>
      </div>

      <!-- Order Details -->
      <div class="md:col-span-2">
        <!-- Initial State -->
        <div id="initial-state" class="card-dark rounded-lg p-12 border border-gray-700 text-center">
          <i class="fas fa-inbox text-5xl text-accent/50 mb-4"></i>
          <h3 class="text-xl font-bold mb-2">Belum Ada Pencarian</h3>
          <p class="text-gray-400">
            Masukkan nomor invoice di sebelah kiri untuk melihat status pesanan Anda
          </p>
        </div>

        <!-- Error State -->
        <div id="error-state" class="hidden card-dark rounded-lg p-8 border border-red-500/30 bg-red-500/10">
          <div class="flex items-start gap-4">
            <i class="fas fa-exclamation-circle text-3xl text-red-400 mt-1"></i>
            <div>
              <h3 class="text-lg font-bold text-red-300 mb-2">Pesanan Tidak Ditemukan</h3>
              <p id="error-message" class="text-gray-300 mb-4">
                Nomor invoice yang Anda masukkan tidak ditemukan dalam sistem kami.
              </p>
              <button 
                type="button"
                onclick="resetForm()"
                class="text-accent hover:underline font-semibold"
              >
                <i class="fas fa-arrow-left mr-2"></i>Coba Lagi
              </button>
            </div>
          </div>
        </div>

        <!-- Success State - Order Found -->
        <div id="success-state" class="hidden space-y-6">
          <!-- Order Status Card -->
          <div class="card-dark rounded-lg p-6 border border-gray-700">
            <div class="flex justify-between items-start mb-6">
              <div>
                <h3 class="text-lg font-bold mb-1">Nomor Invoice</h3>
                <p id="display-invoice" class="text-accent font-mono text-sm">INV-1704110400000-ABC123XYZ</p>
              </div>
              <div id="status-badge" class="px-4 py-2 rounded-full text-sm font-semibold">
                <!-- Status badge will be updated -->
              </div>
            </div>

            <!-- Status Timeline -->
            <div class="space-y-4">
              <!-- Pending -->
              <div class="flex gap-4">
                <div id="pending-dot" class="w-8 h-8 rounded-full border-2 border-gray-700 flex items-center justify-center flex-shrink-0">
                  <i class="fas fa-clock text-sm"></i>
                </div>
                <div class="flex-1 pb-4 border-l-2 border-gray-700">
                  <p class="font-semibold">Menunggu Pembayaran</p>
                  <p class="text-gray-400 text-sm">Pesanan berhasil dibuat, silakan segera melakukan pembayaran</p>
                </div>
              </div>

              <!-- Processing -->
              <div class="flex gap-4">
                <div id="processing-dot" class="w-8 h-8 rounded-full border-2 border-gray-700 flex items-center justify-center flex-shrink-0">
                  <i class="fas fa-cog text-sm"></i>
                </div>
                <div class="flex-1 pb-4 border-l-2 border-gray-700">
                  <p class="font-semibold">Sedang Diproses</p>
                  <p class="text-gray-400 text-sm">Pembayaran dikonfirmasi, pesanan sedang diproses</p>
                </div>
              </div>

              <!-- Completed -->
              <div class="flex gap-4">
                <div id="completed-dot" class="w-8 h-8 rounded-full border-2 border-gray-700 flex items-center justify-center flex-shrink-0">
                  <i class="fas fa-check text-sm"></i>
                </div>
                <div class="flex-1">
                  <p class="font-semibold">Selesai</p>
                  <p class="text-gray-400 text-sm">Pesanan selesai dan siap dikirim/diakses</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Order Details -->
          <div class="card-dark rounded-lg p-6 border border-gray-700">
            <h3 class="text-lg font-bold text-accent mb-6">
              <i class="fas fa-box mr-2"></i>Detail Pesanan
            </h3>

            <div class="space-y-4">
              <!-- Customer Info -->
              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <p class="text-gray-400 text-sm mb-1">Nama Pemesan</p>
                  <p id="display-customer-name" class="font-semibold">-</p>
                </div>
                <div>
                  <p class="text-gray-400 text-sm mb-1">Email</p>
                  <p id="display-customer-email" class="font-semibold">-</p>
                </div>
              </div>

              <div class="grid md:grid-cols-2 gap-4">
                <div>
                  <p class="text-gray-400 text-sm mb-1">No WhatsApp</p>
                  <p id="display-customer-phone" class="font-semibold">-</p>
                </div>
                <div>
                  <p class="text-gray-400 text-sm mb-1">Metode Pembayaran</p>
                  <p id="display-payment-method" class="font-semibold">-</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Order Items -->
          <div class="card-dark rounded-lg p-6 border border-gray-700">
            <h3 class="text-lg font-bold text-accent mb-6">
              <i class="fas fa-list mr-2"></i>Produk Pesanan
            </h3>

            <div id="order-items-list" class="space-y-4">
              <!-- Items will be inserted here -->
            </div>
          </div>

          <!-- Price Summary -->
          <div class="card-dark rounded-lg p-6 border border-gray-700">
            <h3 class="text-lg font-bold text-accent mb-6">
              <i class="fas fa-receipt mr-2"></i>Ringkasan Pembayaran
            </h3>

            <div class="space-y-3">
              <div class="flex justify-between text-gray-300">
                <span>Subtotal:</span>
                <span id="display-subtotal">Rp 0</span>
              </div>
              <div class="flex justify-between text-gray-300">
                <span>Diskon:</span>
                <span id="display-promo-discount" class="text-green-400">Rp 0</span>
              </div>
              <div class="flex justify-between text-gray-300">
                <span>Pajak:</span>
                <span id="display-tax">Rp 0</span>
              </div>
              <div class="flex justify-between items-center pt-3 border-t border-gray-700">
                <span class="font-bold text-lg">Total:</span>
                <span id="display-total" class="text-accent font-bold text-2xl">Rp 0</span>
              </div>
            </div>
          </div>

          <!-- Account/APK Details (if applicable) -->
          <div id="account-details" class="hidden card-dark rounded-lg p-6 border border-green-500/30 bg-green-500/10">
            <h3 class="text-lg font-bold text-green-400 mb-6">
              <i class="fas fa-key mr-2"></i>Data Akun Anda
            </h3>

            <div class="space-y-4">
              <div class="bg-secondary p-4 rounded border border-green-500/50">
                <p class="text-gray-400 text-sm mb-2">Username:</p>
                <div class="flex items-center gap-2">
                  <p id="account-username" class="font-mono text-lg font-bold text-green-400">-</p>
                  <button 
                    type="button"
                    onclick="copyToClipboard('account-username')"
                    class="text-green-400 hover:text-green-300 transition"
                    title="Copy"
                  >
                    <i class="fas fa-copy"></i>
                  </button>
                </div>
              </div>

              <div class="bg-secondary p-4 rounded border border-green-500/50">
                <p class="text-gray-400 text-sm mb-2">Password:</p>
                <div class="flex items-center gap-2">
                  <p id="account-password" class="font-mono text-lg font-bold text-green-400">-</p>
                  <button 
                    type="button"
                    onclick="copyToClipboard('account-password')"
                    class="text-green-400 hover:text-green-300 transition"
                    title="Copy"
                  >
                    <i class="fas fa-copy"></i>
                  </button>
                </div>
              </div>

              <div class="p-4 bg-yellow-500/10 border border-yellow-500/30 rounded text-yellow-300 text-sm">
                <i class="fas fa-warning mr-2"></i>
                <span>Segera ubah password akun Anda untuk keamanan maksimal</span>
              </div>
            </div>
          </div>

          <!-- APK Download -->
          <div id="apk-details" class="hidden card-dark rounded-lg p-6 border border-blue-500/30 bg-blue-500/10">
            <h3 class="text-lg font-bold text-blue-400 mb-6">
              <i class="fas fa-mobile-alt mr-2"></i>Download APK
            </h3>

            <p class="text-gray-300 mb-6">
              Aplikasi Anda siap untuk diunduh. Klik tombol di bawah untuk memulai proses download.
            </p>

            <a id="apk-download-link" href="#" class="w-full btn-primary text-white py-3 rounded-lg font-semibold hover:shadow-lg transition text-center flex items-center justify-center mb-4">
              <i class="fas fa-download mr-2"></i>Download APK Sekarang
            </a>

            <div class="p-4 bg-blue-500/10 border border-blue-500/30 rounded text-blue-300 text-sm">
              <i class="fas fa-info-circle mr-2"></i>
              <span>File APK akan diunduh ke perangkat Anda. Pastikan izin instalasi dari sumber tidak dikenal sudah diaktifkan.</span>
            </div>
          </div>

          <!-- Payment Instructions (Pending Status) -->
          <div id="payment-instructions" class="hidden card-dark rounded-lg p-6 border border-yellow-500/30 bg-yellow-500/10">
            <h3 class="text-lg font-bold text-yellow-400 mb-4">
              <i class="fas fa-exclamation-triangle mr-2"></i>Instruksi Pembayaran
            </h3>

            <div id="qris-payment" class="hidden">
              <p class="text-gray-300 mb-4">
                Silakan scan QR code di bawah untuk menyelesaikan pembayaran:
              </p>
              <div class="bg-white p-4 rounded mb-4 flex justify-center">
                <i class="fas fa-qrcode text-6xl text-gray-700"></i>
              </div>
              <p class="text-gray-400 text-sm">
                Jika QR code tidak muncul, hubungi support kami
              </p>
            </div>

            <div id="transfer-payment" class="hidden">
              <p class="text-gray-300 mb-4">
                Silakan transfer ke rekening berikut:
              </p>
              <div class="bg-secondary p-4 rounded border border-yellow-500/50 mb-4">
                <p class="text-gray-400 text-sm mb-2">Nomor Rekening (BCA):</p>
                <p class="font-mono font-bold text-yellow-400 text-lg mb-3">1234567890</p>
                <p class="text-gray-400 text-sm mb-2">Atas Nama:</p>
                <p class="font-bold text-yellow-400">ClintStore</p>
              </div>
              <p class="text-gray-400 text-sm">
                Setelah transfer, pesanan akan diproses secara otomatis dalam 5-10 menit.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Search form handler
  document.getElementById('track-form').addEventListener('submit', async (e) => {
    e.preventDefault();

    const invoice = document.getElementById('invoice_number').value.trim();

    if (!invoice) {
      showError('Masukkan nomor invoice terlebih dahulu');
      return;
    }

    // Show loading
    document.getElementById('search-btn').classList.add('hidden');
    document.getElementById('search-loading').classList.remove('hidden');

    try {
      const response = await fetch(`/api/orders/${encodeURIComponent(invoice)}`);
      const data = await response.json();

      if (response.ok && data.status === 'success') {
        displayOrder(data.data);
      } else {
        showError(data.error || 'Pesanan tidak ditemukan');
      }
    } catch (error) {
      console.error('Track error:', error);
      showError('Terjadi kesalahan saat mencari pesanan');
    } finally {
      document.getElementById('search-btn').classList.remove('hidden');
      document.getElementById('search-loading').classList.add('hidden');
    }
  });

  // Display order details
  function displayOrder(order) {
    // Hide initial state and error state
    document.getElementById('initial-state').classList.add('hidden');
    document.getElementById('error-state').classList.add('hidden');
    document.getElementById('success-state').classList.remove('hidden');

    // Display invoice
    document.getElementById('display-invoice').textContent = order.invoice_number;

    // Display customer info
    document.getElementById('display-customer-name').textContent = order.customer_name;
    document.getElementById('display-customer-email').textContent = order.customer_email || '-';
    document.getElementById('display-customer-phone').textContent = order.customer_phone || '-';
    document.getElementById('display-payment-method').textContent = order.payment_method === 'qris' ? 'QRIS' : 'Bank Transfer';

    // Display price summary
    const subtotal = order.total_price;
    const discount = subtotal - order.final_price;
    const tax = 0;

    document.getElementById('display-subtotal').textContent = `Rp ${subtotal.toLocaleString('id-ID')}`;
    document.getElementById('display-promo-discount').textContent = `Rp ${discount.toLocaleString('id-ID')}`;
    document.getElementById('display-tax').textContent = `Rp ${tax.toLocaleString('id-ID')}`;
    document.getElementById('display-total').textContent = `Rp ${order.final_price.toLocaleString('id-ID')}`;

    // Display items
    const itemsContainer = document.getElementById('order-items-list');
    itemsContainer.innerHTML = '';

    if (order.items && order.items.length > 0) {
      order.items.forEach(item => {
        const itemHTML = `
          <div class="flex justify-between items-center p-4 bg-secondary rounded border border-gray-700">
            <div>
              <p class="font-semibold">${item.name}</p>
              <p class="text-gray-400 text-sm">Qty: ${item.quantity} x Rp ${item.price.toLocaleString('id-ID')}</p>
            </div>
            <p class="font-bold text-accent">Rp ${item.subtotal.toLocaleString('id-ID')}</p>
          </div>
        `;
        itemsContainer.innerHTML += itemHTML;
      });
    }

    // Update status
    updateOrderStatus(order.order_status, order.payment_status, order.payment_method);

    // Show account/APK details if order is completed
    if (order.order_status === 'completed' && order.payment_status === 'paid') {
      // Check if product is account type (placeholder - bisa disesuaikan dengan data produk)
      if (order.items && order.items[0] && order.items[0].name.toLowerCase().includes('akun')) {
        showAccountDetails();
      } else if (order.items && order.items[0] && order.items[0].name.toLowerCase().includes('apk')) {
        showAPKDetails();
      }
    }

    // Show payment instructions if pending
    if (order.payment_status === 'pending') {
      showPaymentInstructions(order.payment_method);
    }
  }

  // Update status timeline
  function updateOrderStatus(orderStatus, paymentStatus, paymentMethod) {
    const statusBadge = document.getElementById('status-badge');
    const pendingDot = document.getElementById('pending-dot');
    const processingDot = document.getElementById('processing-dot');
    const completedDot = document.getElementById('completed-dot');

    // Reset all
    pendingDot.classList.remove('border-yellow-500', 'bg-yellow-500/20', 'text-yellow-400');
    processingDot.classList.remove('border-blue-500', 'bg-blue-500/20', 'text-blue-400');
    completedDot.classList.remove('border-green-500', 'bg-green-500/20', 'text-green-400');
    pendingDot.classList.add('border-gray-700');
    processingDot.classList.add('border-gray-700');
    completedDot.classList.add('border-gray-700');

    if (paymentStatus === 'pending') {
      statusBadge.innerHTML = '<span class="bg-yellow-500/20 text-yellow-400 px-4 py-2 rounded-full text-sm font-semibold"><i class="fas fa-clock mr-2"></i>Menunggu Pembayaran</span>';
      pendingDot.classList.remove('border-gray-700');
      pendingDot.classList.add('border-yellow-500', 'bg-yellow-500/20', 'text-yellow-400');
    } else if (orderStatus === 'processing') {
      statusBadge.innerHTML = '<span class="bg-blue-500/20 text-blue-400 px-4 py-2 rounded-full text-sm font-semibold"><i class="fas fa-cog mr-2"></i>Sedang Diproses</span>';
      pendingDot.classList.remove('border-gray-700');
      pendingDot.classList.add('border-green-500', 'bg-green-500/20', 'text-green-400');
      processingDot.classList.remove('border-gray-700');
      processingDot.classList.add('border-blue-500', 'bg-blue-500/20', 'text-blue-400');
    } else if (orderStatus === 'completed') {
      statusBadge.innerHTML = '<span class="bg-green-500/20 text-green-400 px-4 py-2 rounded-full text-sm font-semibold"><i class="fas fa-check-circle mr-2"></i>Selesai</span>';
      pendingDot.classList.remove('border-gray-700');
      pendingDot.classList.add('border-green-500', 'bg-green-500/20', 'text-green-400');
      processingDot.classList.remove('border-gray-700');
      processingDot.classList.add('border-green-500', 'bg-green-500/20', 'text-green-400');
      completedDot.classList.remove('border-gray-700');
      completedDot.classList.add('border-green-500', 'bg-green-500/20', 'text-green-400');
    } else if (orderStatus === 'failed') {
      statusBadge.innerHTML = '<span class="bg-red-500/20 text-red-400 px-4 py-2 rounded-full text-sm font-semibold"><i class="fas fa-times-circle mr-2"></i>Gagal</span>';
    }
  }

  // Show account details
  function showAccountDetails() {
    document.getElementById('account-details').classList.remove('hidden');
    // Placeholder data - sesuaikan dengan data dari API
    document.getElementById('account-username').textContent = 'user@example.com';
    document.getElementById('account-password').textContent = 'Password123!';
  }

  // Show APK details
  function showAPKDetails() {
    document.getElementById('apk-details').classList.remove('hidden');
    document.getElementById('apk-download-link').href = 'https://example.com/app.apk';
  }

  // Show payment instructions
  function showPaymentInstructions(paymentMethod) {
    document.getElementById('payment-instructions').classList.remove('hidden');

    if (paymentMethod === 'qris') {
      document.getElementById('qris-payment').classList.remove('hidden');
      document.getElementById('transfer-payment').classList.add('hidden');
    } else {
      document.getElementById('qris-payment').classList.add('hidden');
      document.getElementById('transfer-payment').classList.remove('hidden');
    }
  }

  // Copy to clipboard
  function copyToClipboard(elementId) {
    const text = document.getElementById(elementId).textContent;
    navigator.clipboard.writeText(text).then(() => {
      alert('Berhasil disalin ke clipboard!');
    });
  }

  // Show error
  function showError(message) {
    document.getElementById('initial-state').classList.add('hidden');
    document.getElementById('success-state').classList.add('hidden');
    document.getElementById('error-state').classList.remove('hidden');
    document.getElementById('error-message').textContent = message;
  }

  // Reset form
  function resetForm() {
    document.getElementById('track-form').reset();
    document.getElementById('initial-state').classList.remove('hidden');
    document.getElementById('error-state').classList.add('hidden');
    document.getElementById('success-state').classList.add('hidden');
  }
</script>
