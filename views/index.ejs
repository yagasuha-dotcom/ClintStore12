<%- include('layouts/main') %>

<!-- Hero Section -->
<section class="bg-gradient-to-b from-primary to-secondary py-20">
  <div class="max-w-7xl mx-auto px-4">
    <div class="text-center">
      <div class="inline-block bg-accent/20 text-accent px-4 py-2 rounded-full text-sm font-semibold mb-6">
        <i class="fas fa-circle-check mr-2"></i>Sistem Otomatis 24/7
      </div>
      
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        ClintStore – Joki, Akun, APK Premium & Executor
      </h1>
      
      <p class="text-gray-400 text-lg mb-8">
        Dapatkan produk premium dengan kualitas terjamin dan layanan customer service terbaik
      </p>
      
      <a href="/produk" class="inline-block btn-primary text-white px-8 py-3 rounded-lg font-semibold hover:shadow-lg transition">
        <i class="fas fa-shopping-bag mr-2"></i>Mulai Berbelanja
      </a>
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="py-16 bg-primary">
  <div class="max-w-7xl mx-auto px-4">
    <div class="grid md:grid-cols-3 gap-8">
      <!-- Feature 1 -->
      <div class="card-dark p-8 rounded-lg text-center border border-gray-700">
        <div class="text-accent text-4xl mb-4">
          <i class="fas fa-shield-alt"></i>
        </div>
        <h3 class="text-xl font-bold mb-2">100% Aman</h3>
        <p class="text-gray-400">
          Transaksi aman dengan enkripsi tingkat enterprise dan jaminan uang kembali 100%
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="card-dark p-8 rounded-lg text-center border border-gray-700">
        <div class="text-accent text-4xl mb-4">
          <i class="fas fa-rocket"></i>
        </div>
        <h3 class="text-xl font-bold mb-2">Pengiriman Instan</h3>
        <p class="text-gray-400">
          Produk digital langsung dikirim setelah pembayaran dikonfirmasi dalam hitungan menit
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="card-dark p-8 rounded-lg text-center border border-gray-700">
        <div class="text-accent text-4xl mb-4">
          <i class="fas fa-headset"></i>
        </div>
        <h3 class="text-xl font-bold mb-2">Support 24/7</h3>
        <p class="text-gray-400">
          Tim support profesional siap membantu Anda kapan saja melalui berbagai channel
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Latest Products Section -->
<section class="py-16 bg-primary">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex justify-between items-center mb-12">
      <div>
        <h2 class="text-3xl font-bold">Produk Terbaru</h2>
        <p class="text-gray-400 mt-2">Koleksi produk terbaru dan terlengkap</p>
      </div>
      <a href="/produk" class="text-accent hover:text-accent-dark transition font-semibold">
        Lihat Semua <i class="fas fa-arrow-right ml-2"></i>
      </a>
    </div>

    <!-- Products Grid -->
    <div class="grid md:grid-cols-4 gap-6">
      <% if (products && products.length > 0) { %>
        <% const latestProducts = products.slice(0, 4); %>
        <% latestProducts.forEach(product => { %>
          <div class="card-dark rounded-lg overflow-hidden border border-gray-700 hover:border-accent transition group">
            <!-- Product Image Placeholder -->
            <div class="bg-gradient-to-br from-secondary to-primary h-48 flex items-center justify-center group-hover:bg-accent/20 transition">
              <i class="fas fa-box text-4xl text-accent/50"></i>
            </div>

            <div class="p-4">
              <!-- Product Name -->
              <h3 class="font-bold text-lg mb-2 group-hover:text-accent transition line-clamp-2">
                <%= product.name %>
              </h3>

              <!-- Product Description -->
              <p class="text-gray-400 text-sm mb-4 line-clamp-2">
                <%= product.description || 'Produk berkualitas premium' %>
              </p>

              <!-- Price and Stock -->
              <div class="flex justify-between items-center mb-4">
                <span class="text-accent font-bold text-lg">
                  Rp <%= product.price.toLocaleString('id-ID') %>
                </span>
                <span class="text-xs bg-accent/20 text-accent px-2 py-1 rounded">
                  Stok: <%= product.stock %>
                </span>
              </div>

              <!-- Buy Button -->
              <a href="/produk/<%= product.id %>" class="block w-full btn-primary text-white py-2 rounded font-semibold text-center hover:shadow-lg transition">
                <i class="fas fa-shopping-bag mr-2"></i>Beli
              </a>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-span-4 text-center py-8 text-gray-400">
          <p>Produk tidak tersedia</p>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-gradient-to-r from-accent to-accent-dark">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2 class="text-3xl font-bold mb-4">Siap untuk Pengalaman Belanja Terbaik?</h2>
    <p class="text-white/90 mb-8">
      Bergabunglah dengan ribuan pelanggan puas yang telah mempercayai ClintStore
    </p>
    <a href="/produk" class="inline-block bg-white text-accent px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition">
      Jelajahi Produk Sekarang
    </a>
  </div>
</section>
